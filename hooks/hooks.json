{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "bun ./hooks/session-start.ts"
      }
    ],
    "sessionEnd": [
      {
        "command": "bun ./hooks/session-end.ts"
      }
    ],
    "stop": [
      {
        "command": "bun ./hooks/session-end.ts"
      },
      {
        "command": "bun ./skills/jev-harness/adapters/cursor/run.ts stop",
        "timeout": 15,
        "loop_limit": 1
      }
    ],
    "preToolUse": [
      {
        "command": "bun ./hooks/pre-tool-use.ts"
      },
      {
        "command": "bun ./skills/jev-harness/adapters/cursor/run.ts preToolUse",
        "timeout": 15,
        "matcher": "Read|Write|StrReplace|Task|MCP:browser_.*"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "bun ./hooks/pre-tool-use.ts"
      },
      {
        "command": "bun ./hooks/shell-pi.ts"
      },
      {
        "command": "bun ./hooks/shell-playwright.ts"
      },
      {
        "command": "bun ./skills/jev-harness/adapters/cursor/run.ts beforeShellExecution",
        "timeout": 15
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "bun ./hooks/mcp-parakh.ts"
      },
      {
        "command": "bun ./skills/jev-harness/adapters/cursor/run.ts beforeMCPExecution",
        "timeout": 15
      }
    ],
    "postToolUse": [
      {
        "command": "bun ./hooks/nested-claude-md.ts",
        "matcher": "Read|Write|StrReplace|Grep|Glob"
      },
      {
        "command": "bun ./skills/jev-harness/adapters/cursor/run.ts postToolUse",
        "timeout": 15,
        "matcher": "Shell|Read|Write|StrReplace|WebFetch|MCP:.*"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "bun ./skills/jev-harness/adapters/cursor/run.ts beforeSubmitPrompt",
        "timeout": 15
      }
    ],
    "postToolUseFailure": [
      {
        "command": "bun ./skills/jev-harness/adapters/cursor/run.ts postToolUseFailure",
        "timeout": 15,
        "matcher": "Shell"
      }
    ],
    "afterAgentResponse": [
      {
        "command": "bun ./skills/jev-harness/adapters/cursor/run.ts afterAgentResponse",
        "timeout": 15
      }
    ],
    "subagentStart": [
      {
        "command": "bun ./skills/jev-harness/adapters/cursor/run.ts subagentStart",
        "timeout": 15
      }
    ]
  }
}
